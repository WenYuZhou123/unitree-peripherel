<?xml version="1.0"?>
<package format="3">
  <name>inspection_bringup</name>
  <version>0.1.0</version>
  <description>Launch, configuration, and deployment assets for the inspection peripheral workspace.</description>
  <maintainer email="wyz@example.com">wyz</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>inspection_alarm</exec_depend>
  <exec_depend>inspection_env</exec_depend>
  <exec_depend>inspection_msgs</exec_depend>
  <exec_depend>inspection_vision</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
